# Example integration test configuration. Copy to .env or export the
# variables you need, then load them into the environment before running
# the integration configuration:
#
#     set -a; . ./.env; set +a
#
# Only source files you trust. The library does not load .env itself; D
# reads these from the process environment.
#
# Values here are placeholders, not real keys. Never commit a populated
# .env; it is gitignored.

# Free-only inference is the default: 0, unset, or empty keeps free mode,
# only the literal value 1 enables paid inference, and any other value is a
# configuration error.
INTUIT_TEST_ALLOW_PAID=0

# Positive request bounds shared by all live tests.
INTUIT_TEST_MAX_TOKENS=256
INTUIT_TEST_TIMEOUT_SECONDS=90

# Provider API keys. Conventional names; direct provider keys are optional
# for local servers that do not require auth.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
ZEN_API_KEY=
LITELLM_API_KEY=

# Public keyless catalog routers. These defaults need no key.
#INTUIT_TEST_OPENROUTER_URL=https://openrouter.ai
#INTUIT_TEST_MODELSDEV_URL=https://models.dev
#INTUIT_TEST_ZEN_URL=https://opencode.ai

# OpenRouter inference, enabled when OPENROUTER_API_KEY is set. The defaults
# below are catalog-verified zero-price models.
#INTUIT_TEST_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
#INTUIT_TEST_OPENROUTER_TOOL_MODEL=cohere/north-mini-code:free
#INTUIT_TEST_OPENROUTER_DECISION_MODEL=respan/span-01-lite:free
# Optional free embedding model example; unset disables the test.
#INTUIT_TEST_OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Example of a PAID decision model ($0.02/M input tokens). It is never run
# unless you set it yourself plus INTUIT_TEST_ALLOW_PAID=1.
#INTUIT_TEST_OPENROUTER_DECISION_MODEL=inception/mercury-decide

# OpenCode Zen free chat models are restricted to OpenCode clients; SDK
# integration calls skip them. For API inference, select a paid model and set
# ZEN_API_KEY plus INTUIT_TEST_ALLOW_PAID=1.
#INTUIT_TEST_ZEN_MODEL=nemotron-3.5-lightning-free
#INTUIT_TEST_ZEN_TOOL_MODEL=

# LiteLLM proxy catalog. Runs only when a URL is configured.
#INTUIT_TEST_LITELLM_URL=http://localhost:4000

# Direct provider scenarios. URLs are explicit; there are no hosted
# defaults. OpenAI/Qwen append /v1 to the base URL, so a local server might
# be http://127.0.0.1:1234. To target OpenRouter through the OpenAI path use
# exactly https://openrouter.ai/api; that URL alone activates the catalog
# zero-price guard. Any other URL is the operator's cost responsibility.
#INTUIT_TEST_OPENAI_URL=http://127.0.0.1:1234
#INTUIT_TEST_OPENAI_MODEL=
#INTUIT_TEST_OPENAI_TOOL_MODEL=
#INTUIT_TEST_OPENAI_DECISION_MODEL=
#INTUIT_TEST_OPENAI_EMBEDDING_MODEL=

#INTUIT_TEST_QWEN_URL=http://127.0.0.1:1234
#INTUIT_TEST_QWEN_MODEL=
#INTUIT_TEST_QWEN_TOOL_MODEL=
#INTUIT_TEST_QWEN_DECISION_MODEL=
#INTUIT_TEST_QWEN_EMBEDDING_MODEL=

#INTUIT_TEST_CLAUDE_URL=https://api.anthropic.com
#INTUIT_TEST_CLAUDE_MODEL=

# TypeSafe runs decision scenarios only; there are no completions.
#INTUIT_TEST_TYPESAFE_URL=
#INTUIT_TEST_TYPESAFE_DECISION_MODEL=
