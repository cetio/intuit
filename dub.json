{
	"authors": [
		"cet"
	],
	"copyright": "Copyright © 2026, cet",
	"dependencies": {
		"unit-threaded": {
			"repository": "git+https://github.com/cetio/unit-threaded.git",
			"version": "~master"
		}
	},
	"description": "SDK for interfacing with AI LLMs and embeddings models with streaming, tools, routing, and much more.",
	"license": "Apache-2.0",
	"name": "intuit",
	"targetType": "library",
	"targetPath": "bin",
	"configurations": [
		{
			"excludedSourceFiles": [
				"source/tests/*"
			],
			"name": "library",
			"targetType": "library"
		},
		{
			"buildOptions": [
				"unittests"
			],
			"dependencies": {
				"unit-threaded": {
					"repository": "git+https://github.com/cetio/unit-threaded.git",
					"version": "~master"
				}
			},
			"mainSourceFile": "bin/ut.d",
			"name": "unittest",
			"preBuildCommands": [
				"$DUB run unit-threaded -c gen_ut_main -- -f bin/ut.d"
			],
			"targetType": "executable"
		},
		{
			"buildOptions": [
				"unittests"
			],
			"dependencies": {
				"unit-threaded": {
					"repository": "git+https://github.com/cetio/unit-threaded.git",
					"version": "~master"
				}
			},
			"mainSourceFile": "bin/ut.d",
			"name": "integration",
			"preBuildCommands": [
				"$DUB run unit-threaded -c gen_ut_main -- -f bin/ut.d"
			],
			"targetType": "executable",
			"versions": [
				"integration"
			]
		}
	]
}